---
import AnimatedCounter from './AnimatedCounter.astro';
import WaveBackground from './WaveBackground.astro';

interface Props {
  lang?: 'en' | 'zh';
  totalTemplates?: number;
  totalStars?: number;
  totalDownloads?: number;
}

const {
  lang = 'en',
  totalTemplates = 0,
  totalStars = 0,
  totalDownloads = 0,
} = Astro.props;
const isZh = lang === 'zh';
---

<section class="hero-section relative overflow-hidden">
  <!-- Gradient base -->
  <div class="absolute inset-0 bg-gradient-to-br from-primary via-primary-light to-accent-pink opacity-90"></div>

  <!-- Wave animation -->
  <WaveBackground />

  <!-- Subtle geometric accents -->
  <div class="absolute inset-0 overflow-hidden" aria-hidden="true">
    <div class="absolute top-20 right-1/4 h-16 w-16 rotate-45 rounded-lg border border-white/15"></div>
    <div class="absolute bottom-32 left-1/4 h-10 w-10 rounded-full border border-white/10"></div>
  </div>

  <div class="relative mx-auto max-w-7xl px-4 py-20 sm:px-6 sm:py-28 lg:px-8">
    <div class="max-w-3xl">
      <h1 class="text-5xl font-bold tracking-tight text-white sm:text-6xl lg:text-7xl font-display hero-title">
        {isZh ? 'Trapar Waves 模板' : 'Trapar Waves Templates'}
      </h1>
      <p class="mt-5 text-lg text-white/85 sm:text-xl max-w-2xl leading-relaxed">
        {isZh
          ? '精心打造的项目模板集合，覆盖 React、Vue、CLI 和 LLM 开发场景。开箱即用，快速启动你的下一个项目。'
          : 'Carefully crafted project templates for React, Vue, CLI, and LLM development. Production-ready, start building in seconds.'
        }
      </p>

      <!-- CTAs -->
      <div class="mt-8 flex flex-wrap items-center gap-4">
        <a
          href="#templates"
          class="inline-flex items-center rounded-xl bg-white px-6 py-3 text-sm font-semibold text-primary shadow-lg shadow-black/20 hover:shadow-xl hover:scale-[1.02] active:scale-[0.98] transition-all duration-200 motion-reduce:hover:scale-100 motion-reduce:active:scale-100"
        >
          {isZh ? '浏览模板' : 'Browse Templates'}
        </a>
        <code class="hidden sm:inline-flex items-center gap-2 rounded-xl bg-white/15 backdrop-blur-sm px-5 py-3 text-sm text-white/90 font-mono border border-white/20">
          <span class="text-white/50">$</span> pnpm create trapar-waves
        </code>
      </div>
    </div>

    <!-- Stats bar -->
    <div class="mt-14 flex flex-wrap gap-8 sm:gap-12">
      <div class="flex items-center gap-3">
        <div class="flex h-10 w-10 items-center justify-center rounded-lg bg-white/15 backdrop-blur-sm">
          <svg class="h-5 w-5 text-white" aria-hidden="true" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 11H5m14 0a2 2 0 012 2v6a2 2 0 01-2 2H5a2 2 0 01-2-2v-6a2 2 0 012-2m14 0V9a2 2 0 00-2-2M5 11V9a2 2 0 012-2m0 0V5a2 2 0 012-2h6a2 2 0 012 2v2M7 7h10" />
          </svg>
        </div>
        <div>
          <div class="text-2xl font-bold text-white font-display">
            <AnimatedCounter target={totalTemplates} />
          </div>
          <div class="text-sm text-white/60">{isZh ? '模板' : 'Templates'}</div>
        </div>
      </div>

      <div class="flex items-center gap-3">
        <div class="flex h-10 w-10 items-center justify-center rounded-lg bg-white/15 backdrop-blur-sm">
          <svg class="h-5 w-5 text-white" aria-hidden="true" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11.049 2.927c.3-.921 1.603-.921 1.902 0l1.519 4.674a1 1 0 00.95.69h4.915c.969 0 1.371 1.24.588 1.81l-3.976 2.888a1 1 0 00-.363 1.118l1.518 4.674c.3.922-.755 1.688-1.538 1.118l-3.976-2.888a1 1 0 00-1.176 0l-3.976 2.888c-.783.57-1.838-.197-1.538-1.118l1.518-4.674a1 1 0 00-.363-1.118l-3.976-2.888c-.784-.57-.38-1.81.588-1.81h4.914a1 1 0 00.951-.69l1.519-4.674z" />
          </svg>
        </div>
        <div>
          <div class="text-2xl font-bold text-white font-display">
            <AnimatedCounter target={totalStars} />
          </div>
          <div class="text-sm text-white/60">{isZh ? 'GitHub 星标' : 'GitHub Stars'}</div>
        </div>
      </div>

      <div class="flex items-center gap-3">
        <div class="flex h-10 w-10 items-center justify-center rounded-lg bg-white/15 backdrop-blur-sm">
          <svg class="h-5 w-5 text-white" aria-hidden="true" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4" />
          </svg>
        </div>
        <div>
          <div class="text-2xl font-bold text-white font-display">
            <AnimatedCounter target={totalDownloads} suffix="/mo" />
          </div>
          <div class="text-sm text-white/60">{isZh ? 'npm 下载' : 'npm Downloads'}</div>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .hero-title {
    text-shadow: 0 2px 20px rgba(0, 0, 0, 0.15);
  }
</style>

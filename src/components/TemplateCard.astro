---
import type { Template } from '../types/template';
import { CATEGORY_COLORS, CATEGORY_LIGHT_COLORS, categories } from '../data/templates';

interface Props {
  template: Template;
  lang?: 'en' | 'zh';
}

const { template, lang = 'en' } = Astro.props;
const isZh = lang === 'zh';

const colors = CATEGORY_COLORS[template.category] ?? CATEGORY_COLORS.react;
const lightColors = CATEGORY_LIGHT_COLORS[template.category] ?? CATEGORY_LIGHT_COLORS.react;

// Get category label
const category = categories.find(c => c.id === template.category);
const categoryLabel = category ? (isZh ? category.labelZh : category.label) : template.category;

function formatNumber(num: number): string {
  if (num >= 1_000_000) return (num / 1_000_000).toFixed(1) + 'M';
  if (num >= 1_000) return (num / 1_000).toFixed(1) + 'k';
  return num.toString();
}
---

<article
  data-template-category={template.category}
  class="card-entrance group relative overflow-hidden rounded-lg transition-all duration-200 hover:border-gray-300 dark:hover:border-gray-600 hover:shadow-sm"
  style="background-color: var(--color-surface); border: 1px solid var(--color-surface-border);"
>
  <!-- Category badge -->
  <div class:list={['absolute top-3 right-3 px-2 py-0.5 rounded text-[10px] font-medium tracking-wide uppercase transition-transform duration-200 group-hover:scale-105', lightColors]}>
    {categoryLabel}
  </div>

  <div class="p-5 pb-6">
    <!-- Name row -->
    <h3 class="text-[15px] font-semibold leading-tight pr-16">
      <a
        href={`https://github.com/Trapar-waves/${template.githubRepo}`}
        target="_blank"
        rel="noopener noreferrer"
        class="hover:underline decoration-1 underline-offset-2"
        style="color: var(--color-text-primary);"
      >
        {template.name}
      </a>
    </h3>

    <!-- Package name -->
    <p class="mt-0.5 text-xs font-mono" style="color: var(--color-text-muted);">
      {template.npmPackage}
    </p>

    <!-- Description -->
    <p class="mt-2.5 text-sm leading-relaxed" style="color: var(--color-text-secondary);">
      {isZh ? template.descriptionZh : template.description}
    </p>

    <!-- Tech stack -->
    <p class="mt-3 text-xs font-mono" style="color: var(--color-text-muted);">
      {template.techStack.join(' · ')}
    </p>

    <!-- Bottom row: stats + links -->
    <div class="mt-4 flex items-center justify-between pt-3" style="border-top: 1px solid var(--color-surface-border);">
      <div class="flex items-center gap-3 text-xs" style="color: var(--color-text-muted);">
        {template.githubStars !== undefined && (
          <span>★ {formatNumber(template.githubStars)}</span>
        )}
        {template.npmDownloads !== undefined && (
          <span>↓ {formatNumber(template.npmDownloads)}/mo</span>
        )}
        {template.lastUpdated && (
          <span>{template.lastUpdated}</span>
        )}
      </div>

      <div class="flex items-center gap-3 text-xs">
        <a
          href={`https://github.com/Trapar-waves/${template.githubRepo}`}
          target="_blank"
          rel="noopener noreferrer"
          class="font-medium hover:underline decoration-1"
          style="color: var(--color-text-secondary);"
        >
          GitHub
        </a>
        <a
          href={`https://www.npmjs.com/package/${template.npmPackage}`}
          target="_blank"
          rel="noopener noreferrer"
          class="font-medium hover:underline decoration-1"
          style="color: var(--color-text-secondary);"
        >
          npm
        </a>
      </div>
    </div>
  </div>

  <!-- Bottom gradient accent bar -->
  <div class:list={['absolute bottom-0 left-0 right-0 h-1 opacity-60 transition-opacity duration-200 group-hover:opacity-100', colors.bg]} style="mask-image: linear-gradient(to right, transparent, black 40%, black); -webkit-mask-image: linear-gradient(to right, transparent, black 40%, black);"></div>
</article>

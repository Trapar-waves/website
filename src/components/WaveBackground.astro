---
/**
 * Animated wave background — the signature visual element.
 * Uses layered SVG sine waves with CSS animation.
 * Respects prefers-reduced-motion.
 */
---

<div class="wave-bg" aria-hidden="true">
  <svg
    class="wave-svg"
    viewBox="0 0 1440 320"
    preserveAspectRatio="none"
    xmlns="http://www.w3.org/2000/svg"
  >
    <defs>
      <linearGradient id="wave-grad-1" x1="0%" y1="0%" x2="100%" y2="0%">
        <stop offset="0%" stop-color="var(--color-primary)" stop-opacity="0.3" />
        <stop offset="100%" stop-color="var(--color-accent-pink)" stop-opacity="0.3" />
      </linearGradient>
      <linearGradient id="wave-grad-2" x1="0%" y1="0%" x2="100%" y2="0%">
        <stop offset="0%" stop-color="var(--color-primary-light)" stop-opacity="0.2" />
        <stop offset="100%" stop-color="var(--color-accent-pink)" stop-opacity="0.2" />
      </linearGradient>
      <linearGradient id="wave-grad-3" x1="0%" y1="0%" x2="100%" y2="0%">
        <stop offset="0%" stop-color="var(--color-primary)" stop-opacity="0.15" />
        <stop offset="100%" stop-color="var(--color-accent-amber)" stop-opacity="0.15" />
      </linearGradient>
    </defs>

    <!-- Wave layer 1 — slow, large amplitude -->
    <path class="wave-path wave-1" fill="url(#wave-grad-1)" d="
      M0,160 C120,100 240,200 360,160 C480,120 600,200 720,160
      C840,120 960,200 1080,160 C1200,120 1320,200 1440,160
      L1440,320 L0,320 Z
    " />

    <!-- Wave layer 2 — medium speed, offset -->
    <path class="wave-path wave-2" fill="url(#wave-grad-2)" d="
      M0,200 C160,150 320,250 480,200 C640,150 800,250 960,200
      C1120,150 1280,250 1440,200
      L1440,320 L0,320 Z
    " />

    <!-- Wave layer 3 — fast, small amplitude -->
    <path class="wave-path wave-3" fill="url(#wave-grad-3)" d="
      M0,240 C180,210 360,270 540,240 C720,210 900,270 1080,240
      C1260,210 1440,270 1440,240
      L1440,320 L0,320 Z
    " />
  </svg>
</div>

<style>
  .wave-bg {
    position: absolute;
    inset: 0;
    overflow: hidden;
    pointer-events: none;
  }

  .wave-svg {
    position: absolute;
    bottom: 0;
    left: 0;
    width: 200%;
    height: 100%;
  }

  .wave-path {
    transform-origin: center;
  }

  /* Wave 1: slow drift */
  .wave-1 {
    animation: wave-drift 12s ease-in-out infinite alternate;
  }

  /* Wave 2: medium drift, opposite direction */
  .wave-2 {
    animation: wave-drift 8s ease-in-out infinite alternate-reverse;
  }

  /* Wave 3: fast drift */
  .wave-3 {
    animation: wave-drift 6s ease-in-out infinite alternate;
  }

  @keyframes wave-drift {
    0% {
      transform: translateX(0);
    }
    100% {
      transform: translateX(-25%);
    }
  }

  /* Reduced motion: static waves, no animation */
  @media (prefers-reduced-motion: reduce) {
    .wave-1,
    .wave-2,
    .wave-3 {
      animation: none;
    }
  }
</style>
